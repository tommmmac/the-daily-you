# Copy to .env and edit. Everything here is optional.
# Name, paper name, dateline, day cutoff, language, pronouns and models can also be set on the
# Settings page, which saves to data/settings.json and wins over these.

# Your name, used in prompts ("You're interviewing Tom about their day").
USER_NAME=
# Shown in the masthead.
PAPER_NAME=The Daily You
# Printed before each story: **MELBOURNE:** ...
DATELINE=HOME
# Chats before this hour count as the previous day.
DAY_CUTOFF_HOUR=4
# What the Reporter chats in and the paper is written in.
PAPER_LANGUAGE=English
# How the paper refers to you: he/him, she/her, they/them, or anything else. Blank keeps it gender-neutral.
PRONOUNS=

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_KEEP_ALIVE=30m
MODEL_REPORTER=qwen2.5:14b
MODEL_COPYDESK=qwen2.5:14b
MODEL_ROUTER=qwen2.5:14b

# Server
PORT=3000
HOST=127.0.0.1
# DATA_DIR=./data
