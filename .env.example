# Copy to .env and edit. Everything here is optional.

# Your name, used in prompts ("You're interviewing Tom about their day").
USER_NAME=
# Printed before each story: **MELBOURNE** — ...
DATELINE=HOME
# Chats before this hour count as the previous day.
DAY_CUTOFF_HOUR=4

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_KEEP_ALIVE=30m
MODEL_REPORTER=qwen2.5:14b
MODEL_COPYDESK=qwen2.5:14b
MODEL_ROUTER=qwen2.5:14b

# Server
PORT=3000
HOST=127.0.0.1
# DATA_DIR=./data
